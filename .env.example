# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_ADMIN_PASSWORD=change-this-local-admin-password

# Only needed once when migrating old Firestore data into Supabase.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIRESTORE_DATABASE_ID=your-firestore-database-id
FIREBASE_SERVICE_ACCOUNT_PATH=C:\absolute\path\to\firebase-service-account.json
