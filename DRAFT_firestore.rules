rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for Product
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'category', 'costPrice', 'marketPrice', 'stock', 'image', 'status', 'sku'])
        && data.keys().size() <= 15 // Allow for optional fields if any
        && data.name is string && data.name.size() <= 200
        && data.category is string && data.category.size() <= 100
        && data.costPrice is number && data.costPrice >= 0
        && data.marketPrice is number && data.marketPrice >= 0
        && data.stock is number && data.stock >= 0
        && data.image is string && data.image.size() <= 2000
        && data.status in ['In Stock', 'Low Stock', 'Out of Stock']
        && data.sku is string && data.sku.size() <= 50;
    }

    // Validation for ActivityLog
    function isValidActivityLog(data) {
      return data.keys().hasAll(['productName', 'action', 'time', 'type'])
        && data.keys().size() <= 6
        && data.productName is string && data.productName.size() <= 200
        && data.action is string && data.action.size() <= 500
        && data.time is string // format check could be more robust but string is okay for now
        && data.type in ['inventory', 'price', 'alert'];
    }

    // --- Collections ---

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isSignedIn() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isSignedIn() && isValidId(productId);
    }

    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(activityId) && isValidActivityLog(incoming());
      allow delete: if isSignedIn() && isValidId(activityId);
    }
  }
}
